[sub_resource type="GDScript" id="GDScript_16ubp"]
script/source = "extends Node
#funkční mrdka
var keys = 0
var allKeys = false

var max_hp = 100
var hp = 100

@onready var health_bar = get_node(\"../CanvasLayer/HealthBar\")

func _ready():
	health_bar.max_value = max_hp
	health_bar.value = hp

func hello():
	print(\"Hellddo?\")
	
	
func add_key():
	keys +=1
	print(keys)
	
func all_keys():
	if keys == 3:
		print(\"Máme všechny klíče\")
		allKeys = true

func hit():
	print(hp)
	hp -= 20
	hp = max(hp, 0)
	health_bar.value = hp
	if hp <=0:
		get_tree().reload_current_scene()
"

