[gd_scene format=3 uid="uid://bf8ko0xy8u8t7"]

[sub_resource type="GDScript" id="GDScript_16ubp"]
script/source = "extends Node
#funkční mrdka
var max_keys = 4
var keys = 0
var allKeys = false

var max_hp = 100
var hp = 100

@onready var health_bar = get_node(\"../CanvasLayer/HealthBar\")
@onready var progress_bar = get_node(\"../CanvasLayer2/ProgressBar\")

func _ready():
	health_bar.max_value = max_hp
	health_bar.value = hp
	progress_bar.max_value = max_keys
	progress_bar.value = keys
	
func hello():
	print(\"Hellddo?\")
	
	
func add_key():
	keys +=1
	progress_bar.value = keys
	print(keys)
	
func all_keys():
	if keys >= 4:
		print(\"Máme všechny klíče\")
		allKeys = true
		return allKeys
	else:
		allKeys = false
		return allKeys

func hit():
	print(hp)
	hp -= 20
	hp = max(hp, 0)
	health_bar.value = hp
	if hp <=0:
		get_tree().reload_current_scene()
		
func heal():
	hp = max_hp
	health_bar.value = hp
"

